APP_NAME=Shop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_PREFIX=inno_
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=innoshop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- zwxc-custom: GeoNames / MaxMind GeoLite2（不提交密钥与大体积数据） ---
CUSTOMGEO_ENABLED=true

# GeoNames（无需 key，遵守 CC BY 4.0 署名）
GEONAMES_BASE_URL=https://download.geonames.org/export/dump
GEONAMES_IMPORT_MODE=slim
GEONAMES_DATA_PATH=
GEONAMES_SLIM_COUNTRIES=

# MaxMind GeoLite2（免费注册 https://www.maxmind.com/en/geolite2/signup 获取 key）
MAXMIND_LICENSE_KEY=
MAXMIND_BACKUP_KEEP=3

# GeoLite2 数据库路径（默认 storage/app/geolite2/；如需自定义再取消注释，切勿留空值）
# GEOLITE2_PATH=storage/app/geolite2/geolite2-city.mmdb
# GEOLITE2_CITY_PATH=
# GEOLITE2_COUNTRY_PATH=

# 前台自动定位与缓存
CUSTOMGEO_AUTODETECT_DEFAULT=true
CUSTOMGEO_CACHE=true
CUSTOMGEO_CACHE_TTL=86400

# 调试路由（生产环境请设置随机 token，访问 /customgeo/debug?token=xxx）
CUSTOMGEO_DEBUG_ROUTE=true
CUSTOMGEO_DEBUG_TOKEN=

# --- 本地调试入口（见《本地部署指南》§4；生产环境必须关闭）---
# APP_DEBUG / LOG_LEVEL 已在上方定义，此处不重复声明
DEBUGBAR_ENABLED=true
SCRIBE_ENABLED=false

# --- 迭代扩展占位（本期只留配置契约，代码未接线）---
# 新增能力一律落在 plugins/ 与 themes/，不改 innopacks/ 核心包
GEO_GENERATIVE_ENABLED=false
GEO_TARGETING_ENABLED=false
SUPPLIER_GATEWAY_ENABLED=false
MARKET_DEFAULT=en

# --- 生产部署：只改值，不改 config/ 代码；密钥只放 .env（不入库）---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.example
# DB_PASSWORD=<生产密码，仅写 .env>
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# FILESYSTEM_DISK=s3
# MAIL_MAILER=smtp
# CUSTOMGEO_DEBUG_ROUTE=false
# DEBUGBAR_ENABLED=false
